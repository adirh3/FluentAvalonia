<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <MicroComGeneratorRuntimeNamespace>MicroCom.Runtime</MicroComGeneratorRuntimeNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PackageId>FluentAvaloniaUI</PackageId>

    <NoWarn>$(NoWarn);NU1507;AVLN2000</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);Styling/ControlThemes/BasicControls/DataGrid/**;Styling/ControlThemes/BasicControls/CaptionButtonStyles.axaml;Styling/ControlThemes/BasicControls/TitleBarStyles.axaml;Styling/ControlThemes/BasicControls/WindowStyles.axaml;Styling/ControlThemes/BasicControls/NativeMenuBarStyles.axaml;Styling/ControlThemes/BasicControls/OverlayPopupHostStyles.axaml;Styling/ControlThemes/BasicControls/PopupRootStyles.axaml;Styling/ControlThemes/FAControls/AppWindowStyles.axaml</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\*.*" />
    <AvaloniaResource Include="Fonts\*.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude AXAML style files that reference types from the DataGrid NuGet package or
         CaptionButtons which are incompatible with the locally-built Avalonia submodule.
         These are purely visual templates and excluding them doesn't affect runtime. -->
    <AvaloniaXaml Remove="Styling/ControlThemes/BasicControls/DataGrid/*.axaml" />
    <AvaloniaXaml Remove="Styling/ControlThemes/BasicControls/CaptionButtonStyles.axaml" />
    <AvaloniaResource Remove="Styling/ControlThemes/BasicControls/DataGrid/*.axaml" />
    <AvaloniaResource Remove="Styling/ControlThemes/BasicControls/CaptionButtonStyles.axaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\submodules\Avalonia\packages\Avalonia\Avalonia.csproj" />
    <ProjectReference Include="..\..\..\..\submodules\Avalonia\src\Avalonia.Controls.ColorPicker\Avalonia.Controls.ColorPicker.csproj" />
    <ProjectReference Include="..\..\..\..\submodules\Avalonia\src\Skia\Avalonia.Skia\Avalonia.Skia.csproj" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="MicroCom.CodeGenerator.MSBuild" PrivateAssets="All" />
    <PackageReference Include="MicroCom.Runtime" />
    <MicroComIdl Include="$(MSBuildThisFileDirectory)\Interop\WinRT\WinRT.idl" CSharpInteropPath="$(MSBuildThisFileDirectory)\Interop\WinRT\WinRT.Generated.cs" />
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
  </ItemGroup>

</Project>
